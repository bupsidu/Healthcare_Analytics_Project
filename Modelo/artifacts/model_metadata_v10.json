{
  "release": "modelo-v10-feriados",
  "experimento": "v10 — v9 + calendario de feriados nacionales de Chile",
  "descripcion": "Los feriados mueven la demanda +11-12% de forma estable entre años (2024 ratio 1.106, 2025 ratio 1.124) y varios de los días de mayor demanda relativa del año son feriados. v9 no los modelaba: un feriado que cae lunes se trataba como lunes normal. v10 agrega Es_Feriado, Es_Feriado_Largo, Dias_Al_Feriado (víspera/resaca) y Feriado_Irrumpido (puentes).",
  "justificacion_diagnostica": {
    "ratio_demanda_feriado_vs_no_feriado": {
      "2024": 1.106,
      "2025": 1.124
    },
    "dias_top_demanda_relativa_2025": {
      "2025-05-21": {
        "rel": 1.62,
        "feriado": true
      },
      "2025-08-15": {
        "rel": 1.46,
        "feriado": true
      },
      "2025-06-20": {
        "rel": 1.4,
        "feriado": true
      }
    }
  },
  "fuente_calendario": "Ley 19.973 y Ley 20.215. Feriados nacionales declarados en el módulo, sin dependencias externas, para reproducibilidad auditable. Excluye feriados regionales (no distinguibles por comuna en el dataset).",
  "features_nuevas": {
    "Es_Feriado": "la fecha es feriado nacional",
    "Es_Feriado_Largo": "feriado cae lunes o viernes",
    "Dias_Al_Feriado": "distancia con signo al feriado más cercano, clip ±7",
    "Feriado_Irrumpido": "día hábil con feriado a ≤2 días (puente)"
  },
  "anti_leakage": {
