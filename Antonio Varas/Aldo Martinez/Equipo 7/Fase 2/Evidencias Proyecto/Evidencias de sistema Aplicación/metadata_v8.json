{
  "release": "modelo-v8-tendencia",
  "experimento": "v8 — v7 + 5 features de nivel/tendencia regional para corregir la inercia del modelo al nivel de demanda de train 2024",
  "descripcion": "Diagnóstico previo: el sesgo por región de v7 correlaciona −0.66 con el cambio real de volumen 2024→2025 (Atacama −17.3% real → +28.4% sesgo; O'Higgins −23.8% → +26.6%; Los Lagos +3.4% → −10.1%). Ninguna feature de v7 reflejaba el nivel regional reciente, así que el modelo anclaba su predicción al nivel 2024. v8 agrega features de nivel/tendencia regional con ventanas que terminan en T−4.",
  "features_nuevas": {
    "Region_Total_Lag_4": "total diario regional en T−4",
    "Region_Media_28d_lag4": "media 4 semanas ([T−31..T−4]) del total regional",
    "Region_Trend_Ratio": "media reciente / media de las 4 semanas previas (clip [0.25,4], fallback 1.0)",
    "Region_Level_vs_Train": "media reciente regional / media regional de TRAIN 2024 (constante train-only)",
    "Estab_Media_28d_lag4": "media 4 semanas del propio establecimiento"
  },
