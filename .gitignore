# Entornos virtuales Python
venv/
.venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/

# Node / React
node_modules/
dist/
.vite/

# Archivos de configuración sensible
.env

# Archivos de sistema y entorno
.DS_Store
.vscode/
.idea/

# Configuración sensible
.env.local
.env.*.local

# Datos y artefactos de ML: no versionar archivos grandes/generados
# NOTA: las reglas `data/` y `models/` solo aplican en la RAÍZ del repo.
# El proyecto vive en `Modelo/`, por eso se repiten con sufijo /** (abajo,
# en la sección "Proyecto Modelo/").
data/raw/
data/interim/
data/processed/
models/*.joblib
*.parquet
*.log
.atl/

# ---------------------------------------------------------------------------
# Proyecto Modelo/ — reglas equivalentes para el subdirectorio
# ---------------------------------------------------------------------------
# Datos crudos e intermedios: ~3.3 GB, se regeneran con el pipeline.
# NO versionar.
Modelo/data/raw/
Modelo/data/interim/
Modelo/data/processed/
Modelo/data/*.parquet

# Modelos pesados del establecimiento: se REGENERAN ejecutando el script de
# su versión (ver Modelo/src/pipelines/reentrenar_modelo_v*.py). Su metadata
# JSON sí se versiona como evidencia, y los modelos de región (~1.3 MB) también.
#   v6e2  45.6 MB · v7 44.6 MB · v8 78 MB · v9 84 MB · v10 84 MB · v11 90 MB
Modelo/models/*.joblib
Modelo/artifacts/model_rf_directo_v*.joblib

# `Modelo/models/` es un espejo local de trabajo (copiado desde el workspace
# de entrenamiento). TODO su contenido está ya versionado en `Modelo/artifacts/`
# (metadata, cuotas, features) o se regenera con los scripts. Por eso se ignora
# entero: evita (a) duplicar la metadata, (b) subir respaldos *.bak de 43 MB.
Modelo/models/

# Entornos y caché dentro de Modelo/
Modelo/.venv/
Modelo/**/__pycache__/

# ---------------------------------------------------------------------------
# Artefactos del modelo: se versionan los modelos de región (~1.3 MB) y toda la
# metadata (features, cuotas, metadata de cada versión) como EVIDENCIA del
# proceso de iteración v1→v7. Solo se excluyen los modelos brutos pesados:
#   - v1 (83 MB, con data leakage: los rangos etarios sumaban el target)
#   - v2 (54 MB, superado)
#   - v6e2 (45.6 MB, modelo directo a nivel establecimiento: se REGENERA con
#     Modelo/src/pipelines/reentrenar_modelo_v6_e2_directo.py; la metadata
#     model_metadata_v6e2.json sí se versiona como evidencia)
Modelo/artifacts/model_rf_respiratorio_v1.joblib
Modelo/artifacts/model_rf_respiratorio_v2.joblib
Modelo/artifacts/model_rf_directo_v6e2.joblib

# Artefactos pesados locales
Modelo/artifacts/local_v1/

# Carpeta de entrega para demos: contiene SQL con fechas concretas que caducan.
# Se regenera con Modelo/src/serving/predecir_futuro.py y se comparte por canal
# interno, no se versiona.
Modelo/entrega_demo/
